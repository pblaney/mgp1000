// #################################################### \\
// ~~~~~~~~~~ SELF-CONTAINED STATE TRACKER ~~~~~~~~~~~~ \\
// #################################################### \\
// Declared without 'def' to place it in the global script binding,
// making it accessible to all process closures in this config file.
multipliers = [:].asSynchronized()

// Retrieves the resource multiplier for a specific task (defaults to 1)
getMultiplier = { task ->
    return multipliers.getOrDefault(task.name, 1)
}

// #################################################### \\
// ~~~~~~~~~~~~ INTELLIGENT ERROR HANDLER ~~~~~~~~~~~~~ \\
// #################################################### \\
handleTaskError = { task, fallbackStrategy = 'terminate' ->
    def status = task.exitStatus
    def statusStr = (status == null) ? 'null' : status.toString().trim()

    // 1. HPC NODE / SYSTEM FAILURES (null, -, -1, 255)
    // Retries with identical resources. Multiplier remains at its current value.
    if (status == null || status == -1 || statusStr == '-' || statusStr == '' || status == 255) {
        log.warn "[HPC NODE FAILURE] Task '${task.name}' failed due to system/node issue (Exit Code: ${statusStr}). Retrying with identical resources (Multiplier: ${getMultiplier(task)})."
        return 'retry'
    }

    // 2. RESOURCE EXHAUSTION (134=Abort/JVM OOM, 137=OOM, 140=Timeout, 143=SIGTERM)
    // Increments the task's custom multiplier and retries with scaled resources.
    def resourceCodes = [134, 137, 140, 143]
    def isResourceError = (status instanceof Integer && resourceCodes.contains(status)) || 
                          (statusStr.isInteger() && resourceCodes.contains(statusStr.toInteger()))
                          
    if (isResourceError) {
        def currentMult = multipliers.getOrDefault(task.name, 1)
        def newMult = currentMult + 1
        multipliers.put(task.name, newMult)
        log.warn "[RESOURCE EXHAUSTION] Task '${task.name}' failed (Exit Code: ${status}). Increasing resource multiplier to ${newMult} and retrying."
        return 'retry'
    }

    // 3. FATAL CODE ERRORS (1, 2, 126, 127)
    // Fails immediately to avoid wasting cluster allocation.
    def fatalCodes = [1, 2, 126, 127]
    def isFatalError = (status instanceof Integer && fatalCodes.contains(status)) || 
                       (statusStr.isInteger() && fatalCodes.contains(statusStr.toInteger()))
                       
    if (isFatalError) {
        log.error "[FATAL ERROR] Task '${task.name}' failed with code ${status}. Terminating workflow."
        return 'terminate'
    }

    // 4. Default Fallback behavior
    log.warn "[TASK WARNING] Task '${task.name}' failed with exit status ${statusStr}. Fallback strategy: '${fallbackStrategy}'."
    return fallbackStrategy
}

// #################################################### \\
// ~~~~~~~~~~~~~~~ SLURM CONFIGURATION ~~~~~~~~~~~~~~~~ \\
// #################################################### \\
executor {
    name = 'slurm'
    queueSize = "${params.queue_size}"
    queueStatInterval = '5 min'
    exitReadTimeout = '60 min'
    submitRateLimit = '10sec'
}

profiles {
    singularity.enabled = true
    singularity.autoMounts = true
    
    // ############################################ \\
    // ~~~~~~~~~~ PREPROCESSING PROFILE ~~~~~~~~~~~ \\
    // ############################################ \\
    preprocessing {

        process {
            executor = 'slurm'
            clusterOptions = '--ntasks-per-node=1'
            maxRetries = 20
            errorStrategy = { handleTaskError(task, 'ignore') }
            errorDelay = { task.attempt == 1 ? '2s' : task.attempt == 2 ? '30s' : '2m' }

            withName: mergeLaneSplitFastqs_mergelane {
                container = "containers/base-2.0.simg"
                cpus = 1
                memory = 2.GB
                time = 12.h
                errorStrategy = { handleTaskError(task, 'terminate') }
            }
            withName: gatherInputFastqs_fastqgatherer {
                container = "containers/base-2.0.simg"
                cpus = 1
                memory = 256.MB
                time = 3.h
                errorStrategy = { handleTaskError(task, 'terminate') }
            }
            withName: revertMappedBam_gatk {
                container = "containers/gatk-4.3.0.0.simg"
                cpus = 16
                memory = { 8.GB * task.cpus }
                time = { 48.h * getMultiplier(task) }
            }
            withName: bamToFastq_biobambam {
                container = "containers/mgpconda-1.0.simg"
                cpus = 1
                memory = { 4.GB * getMultiplier(task) }
                time = { 24.h + 24.h * getMultiplier(task) }
            }
            withName: fastqTrimming_trimmomatic {
                container = "containers/mgpconda-1.0.simg"
                cpus = 12
                memory = { 2.GB * task.cpus + 12.GB }
                time = 48.h
            }
            withName: fastqQualityControlMetrics_fastqc {
                container = "containers/mgpconda-1.0.simg"
                cpus = 1
                memory = { 4.GB * getMultiplier(task) }
                time = { 18.h * getMultiplier(task) }
            }
            withName: alignment_bwa {
                container = "containers/mgpcore-1.0.simg"
                cpus = 24
                memory = { 32.GB * getMultiplier(task) + 6.GB * task.cpus }
                time = { 48.h + 24.h * getMultiplier(task) }
            }
            withName: alignmentPostprocessing_samtools {
                container = "containers/mgpcore-1.0.simg"
                cpus = 24
                memory = { 6.GB * task.cpus * getMultiplier(task) }
                time = 16.h
            }
            withName: localAndGlobalRealignment_abra2 {
                container = "containers/mgpcore-1.0.simg"
                cpus = 16
                memory = { 4.GB + 2.GB * task.cpus }
                time = 24.h
            }
            withName: downsampleBam_gatk {
                container = "containers/gatk-4.3.0.0.simg"
                cpus = 2
                memory = { 6.GB + 8.GB * task.cpus }
                time = 24.h
            }
            withName: baseRecalibrator_gatk {
                container = "containers/gatk-4.3.0.0.simg"
                cpus = 16
                memory = { 6.GB + 4.GB * task.cpus }
                time = 16.h
            }
            withName: applyBqsr_gatk {
                container = "containers/gatk-4.3.0.0.simg"
                cpus = 16
                memory = { 6.GB + 4.GB * task.cpus }
                time = 16.h
            }
            withName: alignmentQualityControl_alfred {
                container = "containers/alfred-0.2.7.simg"
                cpus = 1
                memory = { 8.GB + 8.GB * getMultiplier(task) }
                time = { 8.h * getMultiplier(task) }
            }
        }
    }

    // ############################################ \\
    // ~~~~~~~~~~~~~ GERMLINE PROFILE ~~~~~~~~~~~~~ \\
    // ############################################ \\
    germline {

        process {
            executor = 'slurm'
            clusterOptions = '--ntasks-per-node=1'
            maxRetries = 20
            errorStrategy = { handleTaskError(task, 'terminate') }
            errorDelay = { task.attempt == 1 ? '2s' : task.attempt == 2 ? '1m' : '5m' }

            withName: snpAndIndelCalling_deepvariant {
                container = "containers/deepvariant-1.5.0.simg"
                cpus = { 2 + 4 * getMultiplier(task) }
                memory = { 4.GB * getMultiplier(task) + 1.GB * task.cpus }
                time = { 3.h + 2.h * getMultiplier(task) }
            }
            withName: snpAndIndelCallingForPanel_deepvariant {
                container = "containers/deepvariant-1.5.0.simg"
                cpus = 6
                memory = { 4.GB * task.cpus }
                time = 6.h
            }
            withName: mergeAndSortVcfs_gatk {
                container = "containers/gatk-4.3.0.0.simg"
                cpus = 1
                memory = 8.GB
                time = 1.h
            }
            withName: variantFilter_gatk {
                container = "containers/gatk-4.3.0.0.simg"
                cpus = 1
                memory = 12.GB
                time = 1.h
            }
            withName: alleleFrequencyEstimation_angsd {
                container = "containers/angsd-0.941.simg"
                cpus = 2
                memory = { 32.GB + 8.GB * task.cpus }
                time = 24.h
            }
            withName: ancestryEstimation_fastngsadmix {
                container = "containers/mgpcore-1.0.simg"
                cpus = 1
                memory = 8.GB
                time = 24.h
            }
        }
    }

