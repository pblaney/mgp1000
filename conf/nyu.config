// #################################################### \\
// ~~~~~~~~~~~~~~~ SLURM CONFIGURATION ~~~~~~~~~~~~~~~~ \\

executor {
    name = 'slurm'
    queueSize = "${params.queue_size}"
    queueStatInterval = '5 min'
    exitReadTimeout = '60 min'
    submitRateLimit = '10sec'
}

// Profiles for individual modules of the MGP1000: Preprocessing, Germline, and Somatic
profiles {
    
	// ############################################ \\
	// ~~~~~~~~~~ PREPROCESSING PROFILE ~~~~~~~~~~~ \\
	preprocessing {
        singularity.enabled = true
        singularity.autoMounts = true

        process {
            executor = 'slurm'
            clusterOptions = '--nodes=1 --ntasks-per-node=1'
            errorDelay = { task.attempt <= 5 ? '5s' : '20s' }
            maxRetries = 25
            errorStrategy = {
                def fatalCodes = [1, 2, 3, 126, 127]
                if (task.exitStatus in fatalCodes) {
                    return 'terminate'
                } else {
                    return 'retry'
                }
            }

            withName: mergeLaneSplitFastqs_mergelane {
                container = "containers/base-2.0.simg"
                cpus = 1
                memory = 2.GB
                time = 12.h
            }
            withName: gatherInputFastqs_fastqgatherer {
                container = "containers/base-2.0.simg"
                cpus = 1
                memory = 256.MB
                time = 3.h
            }
            withName: revertMappedBam_gatk {
                container = "containers/gatk-4.3.0.0.simg"
                clusterOptions = '--nodes=1 --ntasks-per-node=1 --nodelist=cl40s-[8010-8013],fn-[0001-0003],fn2-[0001-0003]'
                cpus = 16
                memory = { 8.GB * task.cpus }
                time = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 60.h
                    } else {
                        return 48.h
                    }
                }
            }
            withName: bamToFastq_biobambam {
                container = "containers/mgpconda-1.0.simg"
                clusterOptions = '--nodes=1 --ntasks-per-node=1 --nodelist=cl40s-[8010-8013],fn-[0001-0003],fn2-[0001-0003]'
                cpus = 1
                memory = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 16.GB
                    } else {
                        return 4.GB
                    }
                }
                time = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 60.h
                    } else {
                        return 24.h
                    }
                }
            }
            withName: fastqTrimming_trimmomatic {
                container = "containers/mgpconda-1.0.simg"
                cpus = 12
                memory = { 2.GB * task.cpus + 12.GB}
                time = 48.h
            }
            withName: fastqQualityControlMetrics_fastqc {
                container = "containers/mgpconda-1.0.simg"
                cpus = 1
                memory = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 16.GB
                    } else {
                        return 4.GB
                    }
                }
                time = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 48.h
                    } else {
                        return 18.h
                    }
                }
            }
            withName: alignment_bwa {
                container = "containers/mgpcore-1.0.simg"
                clusterOptions = '--nodes=1 --ntasks-per-node=1 --nodelist=cl40s-[8010-8013],fn-[0001-0003],fn2-[0001-0003]'
                cpus = 24
                memory = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 6.GB * task.cpus + 72.GB
                    } else {
                        return 6.GB * task.cpus + 32.GB
                    }
                }
                time = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 72.h
                    } else {
                        return 48.h
                    }
                }
            }
            withName: alignmentPostprocessing_samtools {
                container = "containers/mgpcore-1.0.simg"
                clusterOptions = '--nodes=1 --ntasks-per-node=1 --nodelist=cl40s-[8010-8013],fn-[0001-0003],fn2-[0001-0003]'
                cpus = 24
                memory = {
                    def scaleRetryCodes = [134, 137, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 6.GB * task.cpus + 72.GB
                    } else {
                        return 6.GB * task.cpus
                    }
                }
                time = {
                    def scaleRetryCodes = [134, 137, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 48.h
                    } else {
                        return 18.h
                    }
                }
            }
            withName: localAndGlobalRealignment_abra2 {
                container = "containers/mgpcore-1.0.simg"
                cpus = 16
                memory = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 16.GB
                    } else {
                        return 4.GB
                    }
                }
                time = 24.h
            }
            withName: downsampleBam_gatk {
                container = "containers/gatk-4.3.0.0.simg"
                cpus = 2
                memory = { 6.GB + 8.GB * task.cpus }
                time = 24.h
            }
            withName: baseRecalibrator_gatk {
                container = "containers/gatk-4.3.0.0.simg"
                cpus = 16
                memory = { 6.GB + 4.GB * task.cpus }
                time = 16.h
            }
            withName: applyBqsr_gatk {
                container = "containers/gatk-4.3.0.0.simg"
                cpus = 16
                memory = { 6.GB + 4.GB * task.cpus }
                time = 16.h
            }
            withName: alignmentQualityControl_alfred {
                container = "containers/alfred-0.2.7.simg"
                cpus = 1
                memory = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 36.GB
                    } else {
                        return 16.GB
                    }
                }
                time = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 48.h
                    } else {
                        return 13.h
                    }
                }
            }
        }
	}

	// ############################################ \\
	// ~~~~~~~~~~~~~ GERMLINE PROFILE ~~~~~~~~~~~~~ \\
	germline {
        singularity.enabled = true
        singularity.autoMounts = true

        process {
            executor = 'slurm'
            clusterOptions = '--nodes=1 --ntasks-per-node=1'
            errorDelay = { task.attempt <= 5 ? '5s' : '20s' }
            maxRetries = 25
            errorStrategy = {
                def fatalCodes = [1, 2, 3, 126, 127]
                if (task.exitStatus in fatalCodes) {
                    return 'terminate'
                } else {
                    return 'retry'
                }
            }

        	withName: snpAndIndelCalling_deepvariant {
                container = "containers/deepvariant-1.5.0.simg"
                cpus = 6
                memory = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 1.GB * task.cpus + 8.GB
                    } else {
                        return 1.GB * task.cpus
                    }
                }
                time = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 48.h
                    } else {
                        return 13.h
                    }
                }
            }
            withName: snpAndIndelCallingForPanel_deepvariant {
                container = "containers/deepvariant-1.5.0.simg"
                cpus = 6
                memory = { 4.GB * task.cpus }
                time = 6.h
            }
            withName: mergeAndSortVcfs_gatk {
                container = "containers/gatk-4.3.0.0.simg"
                cpus = 1
                memory = 8.GB
                time = 1.h
            }
            withName: variantFilter_gatk {
                container = "containers/gatk-4.3.0.0.simg"
                cpus = 1
                memory = 12.GB
                time = 1.h
            }
            withName: alleleFrequencyEstimation_angsd {
                container = "containers/angsd-0.941.simg"
                cpus = 2
                memory = { 32.GB + 8.GB * task.cpus }
                time = 24.h
            }
            withName: ancestryEstimation_fastngsadmix {
                container = "containers/mgpcore-1.0.simg"
                cpus = 1
                memory = 8.GB
                time = 24.h
            }
        }
	}

	// ############################################ \\
	// ~~~~~~~~~~~~~~ SOMATIC PROFILE ~~~~~~~~~~~~~ \\
	somatic {
        singularity.enabled = true
        singularity.autoMounts = true

        process {
            
            executor = 'slurm'
            clusterOptions = '--nodes=1 --ntasks-per-node=1'
            errorDelay = { task.attempt <= 5 ? '5s' : '20s' }
            maxRetries = 25
            errorStrategy = {
                def fatalCodes = [1, 2, 3, 126, 127]
                if (task.exitStatus in fatalCodes) {
                    return 'terminate'
                } else {
                    return 'retry'
                }
            }

        	withName: identifySampleSex_allelecount {
                container = "containers/allelecount-4.2.1.simg"
                cpus = 1
                memory = 256.MB
                time = 30.m
            }
            withName: downloadBattenbergReferences_battenberg {
                container = "containers/base-2.0.simg"
                cpus = 1
                memory = 8.GB
                time = 13.h
            }
            withName: cnvCalling_battenberg {
                container = "containers/battenberg-2.2.9.simg"
                clusterOptions = '--nodes=1 --ntasks-per-node=1 --nodelist=cl40s-[8010-8013],fn-[0001-0003],fn2-[0001-0003]'
                cpus = 6
                memory = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 10.GB * task.cpus + 120.GB
                    } else {
                        return 10.GB * task.cpus + 80.GB
                    }
                }
                time = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 72.h
                    } else {
                        return 36.h
                    }
                }
            }
            withName: fitCnvProfileExtract_devgru {
                container = "containers/devgru-0.0.0.9000.simg"
                clusterOptions = '--nodes=1 --ntasks-per-node=1 --nodelist=cl40s-[8010-8013],fn-[0001-0003],fn2-[0001-0003]'
                cpus = 12
                memory = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 6.GB * task.cpus + 36.GB
                    } else {
                        return 6.GB * task.cpus
                    }
                }
                time = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 48.h
                    } else {
                        return 13.h
                    }
                }
            }
            withName: consensusCnvPrep_battenberg {
                container = "containers/mgpcore-1.0.simg"
                cpus = 1
                memory = 256.MB
                time = 30.m
            }
            withName: snpPileup_facets {
                container = "containers/iarc-facets-2.0.simg"
                cpus = 1
                memory = 14.GB
                time = 8.h
            }
            withName: cnvCalling_facets {
                container = "containers/iarc-facets-2.0.simg"
                cpus = 1
                memory = {
                    def scaleRetryCodes = [134, 140, 255]
                    if (task.exitStatus in scaleRetryCodes) {
                        return 28.GB * 2
                    } else {
                        return 28.GB
                    }
