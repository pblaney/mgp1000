                        return 13.h
                    }
                }
            }
            withName: filterAndPostprocessMantaVcf_bcftools {
                container = "containers/mgpcore-1.0.simg"
                cpus = 1
                memory = 256.MB
                time = 30.m
            }
            withName: falsePostiveSvFilteringManta_duphold {
